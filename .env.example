APP_NAME=LendyPH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Philippine Standard Time. Every "today", due-date cutoff and daily-collection
# boundary is local; under UTC they read a day stale until 8am Manila.
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Browser origins permitted to call this API cross-origin, comma-separated.
#
# The ONLY per-deployment value in this file — each tenant has its own frontend
# host. Empty means no cross-origin browser access at all, which is the safe
# default: the Next.js frontends reach this API through their own server-side
# proxy and never send an Origin header, so nothing user-facing depends on it.
#
#   portfolio      https://lendyph-staging.abedubas.dev
#   lendy.ph prod  https://app.lendyph.com
#   lendy.ph stg   https://staging-app.lendyph.com
#   binhs prod     https://binhs-coop.lendyph.com
#   binhs staging  https://binhs-coop-staging.lendyph.com
CORS_ALLOWED_ORIGINS=

# Address(es) of a reverse proxy this API sits behind, comma-separated. Read by
# config/trustedproxy.php and scoped to X-Forwarded-For alone in
# bootstrap/app.php.
#
# LEAVE THIS EMPTY. Unset is the correct value on today's fleet, and unset means
# no proxy is trusted and X-Forwarded-For is ignored entirely — exactly what
# every box did before this key existed. Nothing is broken by leaving it blank:
# the limiters in AppServiceProvider are sized to be correct either way. Setting
# it only restores per-applicant fairness, and it is not worth what it costs
# until the design below exists.
#
# What it would buy: the Next.js frontend proxies every browser JSON call
# server-side, so without a trusted proxy each per-IP limiter meters the
# frontend rather than the applicant.
#
# Why it is empty anyway: whatever you name here becomes an address that is
# allowed to dictate $request->ip() for its own requests. If REMOTE_ADDR is
# itself trusted then the caller IS the proxy, and Symfony hands back an
# entirely caller-chosen address — every per-IP limiter bypassed, any branch
# office's login bucket pinnable by a stranger, and
# borrower_submission_tokens.ip_address quietly falsified for anyone reading it
# later as evidence. So the address has to be one that nothing else can send
# from. That rules out this box's own public IP, because the host also runs
# unrelated third-party apps and any of them — or an SSRF in any of them —
# can originate a request from it. It rules out plain loopback for the same
# reason. Enabling this needs the frontend to prove it is the proxy with a
# server-side-only shared-secret header; that design is filed separately and
# does not exist yet.
#
# Exact addresses ONLY, if it is ever populated:
#   - never '*', which the framework expands to 0.0.0.0/0;
#   - no CIDR ranges either. When every entry in the forwarded chain is
#     trusted, Symfony returns the LEFTMOST value — the one the attacker put
#     there — instead of falling back to the real peer.
TRUSTED_PROXIES=

# L5-Swagger
# Serve the API docs at /docs and /api/documentation. Off by default, including
# here: this template gets copied onto real boxes, and open docs must never be
# something you acquire by accident. Flip it to true in your own local .env.
L5_SWAGGER_ENABLED=false
# Regenerate the spec on every request. Convenient locally; on a deployed box
# deploy.sh already runs l5-swagger:generate, so leave this false there.
L5_SWAGGER_GENERATE_ALWAYS=true
# Unused by this app — the OA\Server annotation in Controller.php declares a
# relative url ('/api'), so the generated spec resolves against whatever host
# serves it. Kept only because l5-swagger's stub config references the key.
L5_SWAGGER_CONST_HOST=http://localhost:8000
