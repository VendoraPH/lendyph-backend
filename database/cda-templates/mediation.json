    "sections": [
      {
        "key": "cases",
        "title": "Cases",
        "kind": "table",
        "source": {
          "key": "mediation.cases"
        },
        "columns": [
          {
            "key": "case_number",
            "label": "Case number",
            "format": "text"
          },
          {
            "key": "filed_on",
            "label": "Filed",
            "format": "date"
          },
          {
            "key": "nature",
            "label": "Nature",
            "format": "text"
          },
          {
            "key": "status",
            "label": "Status",
            "format": "text"
          },
          {
            "key": "resolved_on",
            "label": "Resolved",
            "format": "date"
          }
        ]
      },
      {
        "key": "summary",
        "title": "Summary",
        "kind": "fields",
        "fields": [
          {
            "key": "cases_total",
            "label": "Cases handled",
            "type": "number",
            "decimals": 0,
            "source": {
              "key": "mediation.summary"
            }
          },
          {
            "key": "cases_resolved",
            "label": "Resolved",
            "type": "number",
            "decimals": 0,
            "source": {
