              "params": {
                "status": "resolved"
              }
            }
          },
          {
            "key": "cases_pending",
            "label": "Pending",
            "type": "number",
            "decimals": 0,
            "source": {
              "key": "mediation.summary",
              "params": {
                "status": "pending"
              }
            }
          },
          {
            "key": "cases_escalated",
            "label": "Escalated",
            "type": "number",
            "decimals": 0,
            "source": {
              "key": "mediation.summary",
              "params": {
                "status": "escalated"
              }
            }
          }
        ]
      }
    ],
    "rules": [
      {
        "id": "template_verified",
        "type": "check",
        "check": "template.verified",
        "severity": "info",
        "category": "invalid_data",
